"""Organização gerada para a categoria 'ciência'."""


class CategoriaCiencia:
    """Ponte da categoria para o banco de conhecimento."""

    nome_categoria = 'ciência'

    def __init__(self, banco):
        self.banco = banco

    def buscar(self, termo):
        return self.banco.buscar_termo(termo)

    def lacunas(self, termo):
        return self.banco.identificar_lacunas(termo)
